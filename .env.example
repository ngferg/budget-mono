# Local-dev environment for the budget services.
# Copy to `.env` (git-ignored) and fill in. The `run-rest`, `run-auth`,
# `create-stripe-product` and `migrate-dbs` make targets source this file.
# Production does NOT use it — the VPS manages its own environment.

# Per-user SQLite databases live here (already used by every service).
export SQLITE_DB_PATH=budget-lib/dbs

# --- Stripe (Managed Payments) -------------------------------------------------
# Secret + publishable keys: Stripe Dashboard -> Developers -> API keys.
# Use test-mode keys (sk_test_… / pk_test_…) for local development.
export STRIPE_SECRET_KEY=sk_test_your_key_here
export STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# The recurring Price that Checkout Sessions sell. Create it once with:
#   STRIPE_SECRET_KEY=... make create-stripe-product
# then paste the printed price id here.
export STRIPE_PRICE_ID=price_your_price_here

# Signing secret for the /webhooks/stripe endpoint.
#   Local:  `stripe listen --forward-to localhost:3000/webhooks/stripe` prints it.
#   Prod:   Stripe Dashboard -> Developers -> Webhooks -> your endpoint.
export STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Origin Stripe Checkout returns the customer to (no trailing slash).
# Dev is the Vite server; prod is the public site.
export PUBLIC_BASE_URL=http://localhost:5173
